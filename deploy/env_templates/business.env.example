# URL of your deployed Render backend (NO trailing slash)
# Note: The app automatically converts https:// -> wss:// for WebSocket connection
VITE_API_URL=https://your-backend-service-name.onrender.com

# Custom Operator Login Credentials (Optional, defaults to admin / antarpool2026 if omitted)
VITE_OPERATOR_USER=admin
VITE_OPERATOR_PASS=antarpool2026
