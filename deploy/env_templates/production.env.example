# ==============================================================================
# PRODUCTION ENVIRONMENT (EXPRESS SERVER + REST BACKEND)
# ==============================================================================

# Target Backend Mode ('rest' for production custom backend)
VITE_BACKEND=rest

# Production Backend Base URL (NO trailing slash)
# Example: https://api.antarpool.com
VITE_API_URL=https://api.yourdomain.com

# Server Environment Variables (placed in server/.env)
# PORT=5000
# CLIENT_URL=https://client.yourdomain.com
# BUSINESS_URL=https://operator.yourdomain.com
# JWT_SECRET=change-this-to-a-secure-random-secret
# OPERATOR_USER=operator
# OPERATOR_PASS=strong-operator-password
