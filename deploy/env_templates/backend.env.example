# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES TEMPLATE (For Render Web Service)
# ==============================================================================

# Server Listening Port (Render automatically sets this to 10000 or similar)
PORT=5000

# Persistent Disk Database Path (Mount your Render Disk to /data)
DATABASE_PATH=/data/travel.db

# Frontend URLs for CORS Whitelisting
CLIENT_URL=https://antarpool-client.netlify.app
BUSINESS_URL=https://antarpool-business.netlify.app
